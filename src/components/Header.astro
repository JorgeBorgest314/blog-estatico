---
import { getRelativeLocaleUrl } from "astro:i18n";
import IconSunHigh from "@/assets/icons/IconSunHigh.svg";
import IconMoon from "@/assets/icons/IconMoon.svg";
import { stripBase, stripLocale } from "@/utils/withBase";
import { useTranslations } from "@/i18n";
import config from "@/config";
import { CATEGORY_LIST } from "@/utils/categories";

const { site, features } = config;

const locale = Astro.currentLocale ?? site.lang;
const t = useTranslations(locale);

const relativePath = stripBase(Astro.url.pathname).replace(/\/+$/, "") || "/";
const currentPath = stripLocale(relativePath, locale);

const isActive = (path: string) =>
  currentPath === path || currentPath.startsWith(`${path}/`);

const navLinks = [
  ...CATEGORY_LIST.map(({ slug, name }) => ({
    label: name,
    path: `categorias/${slug}`,
  })),
  { label: t.nav.about, path: "about" },
];
---

<a
  id="skip-to-content"
  href="#main-content"
  class="bg-background text-accent absolute inset-s-16 -top-full z-50 px-3 py-2 backdrop-blur-lg transition-all focus:top-4"
>
  {t.a11y.skipToContent}
</a>

<header class="site-container">
  <nav
    class="bg-hn flex flex-wrap items-center gap-x-2 gap-y-1 px-1 py-0.5 font-sans text-[10pt] text-black"
    aria-label={t.nav.home}
  >
    <a
      href={getRelativeLocaleUrl(locale, "")}
      class="bg-hn flex h-[18px] w-[18px] shrink-0 items-center justify-center border border-white leading-none font-bold text-white"
      aria-label={t.nav.home}
    >
      {site.title.charAt(0)}
    </a>
    <a
      href={getRelativeLocaleUrl(locale, "")}
      class="font-bold hover:underline"
    >
      {site.title}
    </a>
    {
      navLinks.map(({ label, path }) => (
        <>
          <span class="text-black/60" aria-hidden="true">
            |
          </span>
          <a
            href={getRelativeLocaleUrl(locale, path)}
            class:list={[
              "hover:underline",
              { "active-nav": isActive(`/${path}`) },
            ]}
          >
            {label}
          </a>
        </>
      ))
    }
    <span class="ms-auto flex items-center gap-x-2">
      {
        features.lightAndDarkMode && (
          <button
            id="theme-btn"
            class="relative size-5"
            title={t.a11y.toggleTheme}
            aria-label="auto"
            aria-live="polite"
          >
            <IconMoon class="absolute top-1/2 left-1/2 size-4 -translate-1/2 scale-100 rotate-0 transition-all dark:scale-0 dark:-rotate-90" />
            <IconSunHigh class="absolute top-1/2 left-1/2 size-4 -translate-1/2 scale-0 rotate-90 transition-all dark:scale-100 dark:rotate-0" />
          </button>
        )
      }
    </span>
  </nav>
</header>

<script>
  function handleSkipToContent() {
    const skipLink = document.getElementById("skip-to-content");
    if (!skipLink) return;
    skipLink.addEventListener("click", e => {
      if (
        e.defaultPrevented ||
        e.metaKey ||
        e.ctrlKey ||
        e.shiftKey ||
        e.button !== 0
      )
        return;
      e.preventDefault();
      const target = document.getElementById("main-content");
      if (target) {
        target.setAttribute("tabindex", "-1");
        target.addEventListener(
          "blur",
          () => target.removeAttribute("tabindex"),
          { once: true }
        );
        target.focus();
        target.scrollIntoView({ behavior: "smooth" });
      }
    });
  }

  handleSkipToContent();
  document.addEventListener("astro:after-swap", handleSkipToContent);
</script>
