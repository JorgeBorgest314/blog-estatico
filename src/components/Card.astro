---
import type { CollectionEntry } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import { getPostUrl } from "@/utils/getPostPaths";
import { toTransitionName } from "@/utils/toTransitionName";
import { CATEGORIES } from "@/utils/categories";
import Datetime from "./Datetime.astro";
import config from "@/config";

type Props = {
  variant?: "h2" | "h3";
} & CollectionEntry<"posts">;

const { variant: Heading = "h2", id, data, filePath } = Astro.props;

const { title, category, pubDatetime, modDatetime, timezone } = data;
const categoryInfo = CATEGORIES[category];
const locale = Astro.currentLocale ?? config.site.lang;
---

<li class="py-2">
  <a
    href={getPostUrl(id, filePath, locale)}
    class:list={[
      "text-foreground inline-block font-serif text-[17px] leading-snug font-bold",
      "focus-visible:no-underline",
      categoryInfo.hoverClass,
    ]}
  >
    <Heading transition:name={toTransitionName(id)}>
      {title}
    </Heading>
  </a>
  <p
    class="text-muted-foreground mt-0.5 flex flex-wrap items-center gap-x-2 font-sans text-[12px]"
  >
    <Datetime {pubDatetime} {modDatetime} {timezone} />
    <span aria-hidden="true">·</span>
    <a
      href={getRelativeLocaleUrl(locale, `categorias/${category}/`)}
      class:list={["hover:underline", categoryInfo.textClass]}
    >
      {categoryInfo.name}
    </a>
  </p>
</li>
