---
import { getYouTubeId, getYouTubeStart, toSeconds } from "@/utils/youtube";
import { useTranslations } from "@/i18n";
import config from "@/config";

type Props = {
  youtube: string;
  start?: string | number;
  title?: string;
};

const { youtube, start, title } = Astro.props;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const id = getYouTubeId(youtube);
const startAt =
  start === undefined ? (getYouTubeStart(youtube) ?? 0) : toSeconds(start);
const label = title ?? t.post.video;

const embedUrl = id
  ? `https://www.youtube-nocookie.com/embed/${id}${startAt ? `?start=${startAt}` : ""}`
  : undefined;
const watchUrl = id
  ? `https://youtu.be/${id}${startAt ? `?t=${startAt}` : ""}`
  : youtube;
---

{
  embedUrl && (
    <section data-pagefind-ignore class="mt-12">
      <h2 class="border-border mb-3 border-b pb-1 font-sans text-[11px] font-bold tracking-[0.2em] uppercase">
        {label}
      </h2>
      <div class="border-border aspect-video w-full border">
        <iframe
          src={embedUrl}
          title={label}
          class="h-full w-full"
          loading="eager"
          referrerpolicy="strict-origin-when-cross-origin"
          allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          allowfullscreen
        />
      </div>
      <p class="text-muted-foreground mt-2 font-sans text-[12px]">
        <a href={watchUrl} class="hover:text-hn underline underline-offset-4">
          {t.post.watchOnYouTube}
        </a>
      </p>
    </section>
  )
}
