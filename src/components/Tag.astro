---
import { getRelativeLocaleUrl } from "astro:i18n";
import config from "@/config";

import { CATEGORIES, type CategorySlug } from "@/utils/categories";

type Props = {
  tag: string;
  tagName: string;
  size?: "sm" | "lg";
  category?: CategorySlug;
};

const { tag, tagName, size = "lg", category } = Astro.props;
const hoverClass = category ? CATEGORIES[category].hoverClass : "hover:text-hn";

const locale = Astro.currentLocale ?? config.site.lang;
---

<li>
  <a
    href={getRelativeLocaleUrl(locale, `tags/${tag}/`)}
    transition:name={tag}
    class:list={[
      "font-sans hover:underline focus-visible:no-underline",
      hoverClass,
      { "text-[12px]": size === "sm", "text-[15px]": size === "lg" },
    ]}
  >
    #{tagName}
  </a>
</li>
