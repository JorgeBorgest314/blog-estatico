---
import { getRelativeLocaleUrl } from "astro:i18n";
import config from "@/config";

type Props = {
  tag: string;
  tagName: string;
  size?: "sm" | "lg";
};

const { tag, tagName, size = "lg" } = Astro.props;

const locale = Astro.currentLocale ?? config.site.lang;
---

<li>
  <a
    href={getRelativeLocaleUrl(locale, `tags/${tag}/`)}
    transition:name={tag}
    class:list={[
      "hover:text-hn font-sans hover:underline focus-visible:no-underline",
      { "text-[12px]": size === "sm", "text-[15px]": size === "lg" },
    ]}
  >
    #{tagName}
  </a>
</li>
