---
import type { HTMLAttributes } from "astro/types";
import { getRelativeLocaleUrl } from "astro:i18n";
import { useTranslations } from "@/i18n";
import config from "@/config";

type Props = {
  noMarginTop?: boolean;
} & HTMLAttributes<"footer">;

const { noMarginTop = false, class: className, ...attrs } = Astro.props;

const { site, socials } = config;
const locale = Astro.currentLocale ?? site.lang;
const t = useTranslations(locale);
const currentYear = new Date().getFullYear();

const capitalize = (name: string) =>
  name.charAt(0).toUpperCase() + name.slice(1);

const links = [
  { label: t.nav.posts, href: getRelativeLocaleUrl(locale, "posts") },
  { label: t.nav.tags, href: getRelativeLocaleUrl(locale, "tags") },
  { label: t.nav.series, href: getRelativeLocaleUrl(locale, "series") },
  { label: t.nav.archives, href: getRelativeLocaleUrl(locale, "arquivo") },
  { label: t.nav.about, href: getRelativeLocaleUrl(locale, "sobre") },
  ...socials.map(({ name, url, linkTitle }) => ({
    label: linkTitle ?? capitalize(name),
    href: url,
  })),
];
---

<footer
  class:list={[
    "site-container border-hn border-t-2 py-4 text-center font-sans text-[10pt]",
    { "mt-auto": !noMarginTop },
    className,
  ]}
  {...attrs}
>
  <nav
    class="text-muted-foreground flex flex-wrap items-center justify-center gap-x-1"
  >
    {
      links.map(({ label, href }, index) => (
        <>
          {index > 0 && <span aria-hidden="true">|</span>}
          <a
            href={href}
            class="hover:text-foreground inline-block px-1.5 py-2.5 hover:underline"
          >
            {label}
          </a>
        </>
      ))
    }
  </nav>
  <p class="text-muted-foreground mt-1 text-[11px]">
    &#169; {`${currentYear} ${site.author}`} &mdash; {
      t.footer.allRightsReserved
    }
  </p>
</footer>
