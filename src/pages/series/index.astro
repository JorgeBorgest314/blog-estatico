---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import { getSeries } from "@/utils/getSeries";
import { useTranslations, postCountLabel } from "@/i18n";
import config from "@/config";

const posts = await getCollection("posts");
const allSeries = getSeries(posts);

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
---

<Layout title={`${t.pages.seriesTitle} | ${config.site.title}`}>
  <Header />

  <Breadcrumb />

  <Main pageTitle={t.pages.seriesTitle} pageDesc={t.pages.seriesDesc}>
    <ul>
      {
        allSeries.map(({ slug, name, posts }) => (
          <li class="border-border border-b py-5 last:border-b-0">
            <a
              href={getRelativeLocaleUrl(locale, `series/${slug}/`)}
              class="text-foreground hover:text-hn inline-block font-serif text-[22px] leading-tight font-bold"
            >
              {name}
            </a>
            <p class="text-muted-foreground mt-1 font-sans text-[12px]">
              {postCountLabel(t, posts.length)}
            </p>
          </li>
        ))
      }
    </ul>
  </Main>

  <Footer />
</Layout>
