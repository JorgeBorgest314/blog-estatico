---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import { CATEGORY_LIST } from "@/utils/categories";
import { getPostsByCategory } from "@/utils/getPostsByCategory";
import { useTranslations, postCountLabel } from "@/i18n";
import config from "@/config";

const posts = await getCollection("posts");
const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const categories = CATEGORY_LIST.map(category => ({
  ...category,
  count: getPostsByCategory(posts, category.slug).length,
}));
---

<Layout title={`${t.pages.categoriesTitle} | ${config.site.title}`}>
  <Header />

  <Breadcrumb />

  <Main pageTitle={t.pages.categoriesTitle} pageDesc={t.pages.categoriesDesc}>
    <ul>
      {
        categories.map(({ slug, name, description, textClass, count }) => (
          <li class="border-border border-b py-5 last:border-b-0">
            <a
              href={getRelativeLocaleUrl(locale, `categorias/${slug}/`)}
              class:list={[
                "hover:text-hn inline-block font-serif text-[22px] leading-tight font-bold",
                textClass,
              ]}
            >
              {name}
            </a>
            <p class="text-muted-foreground mt-1 font-sans text-[12px]">
              {postCountLabel(t, count)}
            </p>
            <p class="mt-2 font-serif text-[16px] leading-[1.6]">
              {description}
            </p>
          </li>
        ))
      }
    </ul>
  </Main>

  <Footer />
</Layout>
