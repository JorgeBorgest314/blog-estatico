---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { perIndex } = config.posts;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);
const listedPosts = sortedPosts.slice(0, perIndex);
const hasMore = sortedPosts.length > perIndex;
const homePath = getRelativeLocaleUrl(locale, "");
---

<Layout>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout py-6"
  >
    {
      listedPosts.length > 0 ? (
        <ol class="post-list">
          {listedPosts.map(data => (
            <Card variant="h2" {...data} />
          ))}
        </ol>
      ) : (
        <p class="text-muted-foreground font-sans text-[13px]">
          {t.home.empty}
        </p>
      )
    }

    {
      hasMore && (
        <p class="mt-6 ps-8 font-sans text-[13px]">
          <a
            href={getRelativeLocaleUrl(locale, "posts/2")}
            class="hover:text-hn underline underline-offset-4"
          >
            {t.home.more}
          </a>
        </p>
      )
    }
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
